# ──────────────────────────────────────────────────────────────────────────────
# Housing Adviser — Backend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The application works WITHOUT any keys (uses rule-based fallback).

# Optional: Google Gemini API key for LLM-generated responses
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: WAQI token for real-time air quality data (same token as map.html)
# Get one FREE (no credit card) at: https://aqicn.org/data-platform/token/
# Without this, the app falls back to curated static AQI data.
WAQI_TOKEN=

# Optional: Override the default port (default = 8000)
# PORT=8000
