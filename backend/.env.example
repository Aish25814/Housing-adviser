# ──────────────────────────────────────────────────────────────────────────────
# Housing Adviser — Backend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The application works WITHOUT a Gemini key (uses rule-based fallback).

# Optional: Google Gemini API key for LLM-generated responses
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Override the default port (default = 8000)
# PORT=8000
